#!/usr/bin/env bash
#
# porg-sync: mirrors the parts of a Supabase project that its containers
# bind-mount from disk.
#
# The Supabase CLI mounts the edge functions and auth email templates by
# absolute path. With the containers on porg those paths have to exist there
# too, so this copies them to porg under the identical path. Everything else
# (migrations, seed, config) is read by the CLI on this machine and sent over
# the wire, so it needs no syncing.
#
# Usage:
#   porg-sync [--watch] [project-dir]
#
# Run it after editing an edge function, or use --watch while iterating.

set -euo pipefail

PORG_HOST="${PORG_HOST:-porg}"
WATCH=0
TARGET=""

while [ $# -gt 0 ]; do
  case "$1" in
    --watch|-w) WATCH=1 ;;
    -h|--help)  sed -n '2,17p' "$0"; exit 0 ;;
    *)          TARGET="$1" ;;
  esac
  shift
done

# Walk up from the starting directory to find the project's supabase/ folder.
find_supabase_dir() {
  local dir="${1:-$PWD}"
  dir="$(cd "$dir" && pwd)"
  while [ "$dir" != "/" ]; do
    if [ -f "$dir/supabase/config.toml" ]; then
      printf '%s\n' "$dir/supabase"
      return 0
    fi
    dir="$(dirname "$dir")"
  done
  return 1
}

SUPA_DIR="$(find_supabase_dir "${TARGET:-$PWD}")" || {
  echo "porg-sync: no supabase/config.toml found above ${TARGET:-$PWD}" >&2
  exit 1
}

sync_once() {
  local sub any=0
  for sub in functions templates; do
    [ -d "$SUPA_DIR/$sub" ] || continue
    any=1
    # Docker creates these mount points as root when they are missing, so make
    # sure they exist and are writable before rsync tries to update them.
    ssh "$PORG_HOST" "sudo mkdir -p '$SUPA_DIR/$sub' && sudo chown -R \$(id -u):\$(id -g) '$SUPA_DIR'"
    rsync -a --delete "$SUPA_DIR/$sub/" "$PORG_HOST:$SUPA_DIR/$sub/"
  done
  [ "$any" = 1 ] || echo "porg-sync: nothing to sync in $SUPA_DIR"
}

if [ "$WATCH" = 1 ]; then
  echo "porg-sync: watching $SUPA_DIR (ctrl-c to stop)"
  sync_once
  echo "porg-sync: synced, watching for changes..."
  # Poll rather than depend on fswatch. The tree is small, so an rsync every
  # couple of seconds is cheaper than another tool to install on each machine.
  while true; do
    sleep 2
    for sub in functions templates; do
      [ -d "$SUPA_DIR/$sub" ] || continue
      rsync -a --delete --out-format='%n' "$SUPA_DIR/$sub/" "$PORG_HOST:$SUPA_DIR/$sub/" | sed "s|^|porg-sync: updated $sub/|"
    done
  done
else
  sync_once
  echo "porg-sync: synced $SUPA_DIR to $PORG_HOST"
fi
